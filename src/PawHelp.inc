    'ADD flagno1 flagno2' +
      LineEnding +
      'Flag flagno2 has the contents of Flag flagno1 added to it. If the result exceeds 255 the flag is set to 255.',
    'ADJECT1 word' +
      LineEnding +
      'Succeeds if the first noun''s adjective in the current LS is word.',
