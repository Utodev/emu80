WRT6: EQU 0x0000FC30
WRT7: EQU 0x0000FC3F
WRT4: EQU 0x0000FC4E
WRTBK: EQU 0x0000FC54
WRNC: EQU 0x0000FC57
WREND: EQU 0x0000FC5E
WRTZ: EQU 0x0000FC6A ; write tape leader IRQ routine
TNIF: EQU 0x0000FC93 ; restore everything for STOP
TNIQ: EQU 0x0000FCB6
STKY: EQU 0x0000FCB8 ; reset vector
BSIV: EQU 0x0000FCBD ; set tape vector
TNOF: EQU 0x0000FCCA ; stop the cassette motor
CMPSTE: EQU 0x0000FCD1 ; check read/write pointer
INCSAL: EQU 0x0000FCDB ; increment read/write pointer
INCR: EQU 0x0000FCE1
START: EQU 0x0000FCE2 ; RESET, hardware reset starts here
START1: EQU 0x0000FCEF
A0INT: EQU 0x0000FD02 ; scan for autostart ROM at $8000, returns Zb=1 if ROM found
A0IN1: EQU 0x0000FD04
A0IN2: EQU 0x0000FD0F
TBLA0R: EQU 0x0000FD10 ; autostart ROM signature
RESTOR: EQU 0x0000FD15 ; restore default I/O vectors
VECTOR: EQU 0x0000FD1A ; set/read vectored I/O from (XY), Cb = 1 to read, Cb = 0 to set
MOVOS1: EQU 0x0000FD20
MOVOS2: EQU 0x0000FD27
KERNAL_VECTORS: EQU 0x0000FD30 ; kernal vectors
RAMTAS: EQU 0x0000FD50 ; test RAM and find RAM end
RAMTZ0: EQU 0x0000FD53
RAMTZ1: EQU 0x0000FD6C
RAMTZ2: EQU 0x0000FD6E
SIZE: EQU 0x0000FD88
BSIT: EQU 0x0000FD9B ; tape IRQ vectors
IOINIT: EQU 0x0000FDA3 ; initialise SID, CIA and IRQ
IOKEYS: EQU 0x0000FDDD
I0010: EQU 0x0000FDEC
I0020: EQU 0x0000FDF3
SETNAM: EQU 0x0000FDF9 ; set filename
SETLFS: EQU 0x0000FE00 ; set logical, first and second addresses
READSS: EQU 0x0000FE07 ; read I/O status word
SETMSG: EQU 0x0000FE18 ; control kernal messages
READST: EQU 0x0000FE1A
UDST: EQU 0x0000FE1C ; OR into the serial status byte
SETTMO: EQU 0x0000FE21 ; set timeout on serial bus
MEMTOP: EQU 0x0000FE25 ; read/set the top of memory, Cb = 1 to read, Cb = 0 to set
GETTOP: EQU 0x0000FE27 ; read the top of memory
SETTOP: EQU 0x0000FE2D ; set the top of memory
MEMBOT: EQU 0x0000FE34 ; read/set the bottom of memory, Cb = 1 to read, Cb = 0 to set
SETBOT: EQU 0x0000FE3C
NMI: EQU 0x0000FE43 ; NMI vector
NNMI: EQU 0x0000FE47 ; NMI handler
NNMI10: EQU 0x0000FE4C
NNMI18: EQU 0x0000FE56
TIMB: EQU 0x0000FE66 ; user function default vector
NNMI20: EQU 0x0000FE72 ; RS232 NMI routine
NNMI22: EQU 0x0000FE9A
NNMI25: EQU 0x0000FE9D
NNMI30: EQU 0x0000FEA3
NNMI40: EQU 0x0000FEAE
NMIRTI: EQU 0x0000FEB6
PREND: EQU 0x0000FEBC
BAUDO: EQU 0x0000FEC2 ; baud rate word is calculated from ..
T2NMI: EQU 0x0000FED6 ; ??
POPEN: EQU 0x0000FF2E ; ??
SIMIRQ: EQU 0x0000FF43 ; save the status and do the IRQ routine
PULS: EQU 0x0000FF48 ; IRQ vector
PULS1: EQU 0x0000FF58
PCINT: EQU 0x0000FF5B ; initialise VIC and screen editor
CINT: EQU 0x0000FF81 ; initialise VIC and screen editor
SECOND: EQU 0x0000FF93 ; send secondary address after LISTEN
ACPTR: EQU 0x0000FFA5 ; input byte from serial bus
LISTEN: EQU 0x0000FFB1 ; command devices on the serial bus to LISTEN
OPEN: EQU 0x0000FFC0 ; open a logical file
CLOSE: EQU 0x0000FFC3 ; close a specified logical file
CHKIN: EQU 0x0000FFC6 ; open channel for input
CKOUT: EQU 0x0000FFC9 ; open channel for output
CLRCH: EQU 0x0000FFCC ; close input and output channels
BASIN: EQU 0x0000FFCF ; input character from channel
BSOUT: EQU 0x0000FFD2 ; output character to channel
STOP: EQU 0x0000FFE1 ; scan the stop key
GETIN: EQU 0x0000FFE4 ; get character from input device
CLALL: EQU 0x0000FFE7 ; close all channels and files
JSCROG: EQU 0x0000FFED ; return X,Y organization of screen
JPLOT: EQU 0x0000FFF0 ; read/set X,Y cursor position
JIOBAS: EQU 0x0000FFF3 ; return the base address of the I/O devices
HARDWARE_VECTORS: EQU 0x0000FFFA ; hardware vectors
