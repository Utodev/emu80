; Labels of the Commodore 64 ROMs (BASIC at A000-BFFF and E000-E4FF, KERNAL at E500-FFFF) and of its system
; variables (RAM). The names are the ones of the original sources: Microsoft's BASIC for the 6502 and Commodore's
; C64 KERNAL (901227-03). The description after each label is the heading of the routine in Lee Davison's
; "almost completely commented C64 ROM disassembly" (or, for the variables, the one of the original source).
; Taken from Michael Steil's C64 reference, https://www.pagetable.com/c64ref/c64disasm/ (github.com/mist64/c64ref).
; ochenta loads this file by itself for the Commodore 64: the ROM labels apply only while that ROM is paged in.
; Same format as the symbol files exported by SjASM/SjASMPlus; the text after ";" is shown as the label's hint.
D6510: EQU 0x00000000 ; 6510 data direction register
R6510: EQU 0x00000001 ; 6510 data register
ADRAY1: EQU 0x00000003 ; Store here the addr of the
ADRAY2: EQU 0x00000005 ; Store here the addr of the
CHARAC: EQU 0x00000007 ; A delimiting character.
ENDCHR: EQU 0x00000008 ; The other delimiting character.
TRMPOS: EQU 0x00000009 ; Position of terminal carriage.
COUNT: EQU 0x0000000B ; A general counter.
DIMFLG: EQU 0x0000000C
VALTYP: EQU 0x0000000D ; The type indicator.
INTFLG: EQU 0x0000000E ; Tells if integer.
GARBFL: EQU 0x0000000F ; Whether to do garbage collection.
SUBFLG: EQU 0x00000010 ; Flag whether sub'd variable allowed.
INPFLG: EQU 0x00000011 ; Flags whether we are doing "INPUT"
TANSGN: EQU 0x00000012 ; Used in determining sign of tangent.
CHANNL: EQU 0x00000013 ; Holds channel number.
LINNUM: EQU 0x00000014 ; Location to store line number before BUF
TEMPPT: EQU 0x00000016 ; Pointer at first free temp descriptor.
LASTPT: EQU 0x00000017 ; Pointer to last-used string temporary.
TEMPST: EQU 0x00000019 ; Storage for NUMTMP temp descriptors.
INDEX: EQU 0x00000022 ; Indexes.
INDEX2: EQU 0x00000024
RESHO: EQU 0x00000026 ; Result of multiplier and divider.
RESMOH: EQU 0x00000027 ; One more byte.
RESMO: EQU 0x00000028
RESLO: EQU 0x00000029
TXTTAB: EQU 0x0000002B ; Pointer to beginning of text.
VARTAB: EQU 0x0000002D ; Pointer to start of simple
ARYTAB: EQU 0x0000002F ; Pointer to beginning of array
STREND: EQU 0x00000031 ; End of storage in use.
FRETOP: EQU 0x00000033 ; Top of string free space.
FRESPC: EQU 0x00000035 ; Pointer to new string.
MEMSIZ: EQU 0x00000037 ; Highest location in memory.
CURLIN: EQU 0x00000039 ; Current line #.
OLDLIN: EQU 0x0000003B ; Old line number
OLDTXT: EQU 0x0000003D ; Old text pointer.
DATLIN: EQU 0x0000003F ; Data line # -- remember for errors.
DATPTR: EQU 0x00000041 ; Pointer to data.
INPPTR: EQU 0x00000043 ; This remembers where input is coming from.
VARNAM: EQU 0x00000045 ; Variable's name is stored here.
VARPNT: EQU 0x00000047 ; Pointer to variable in memory.
FORPNT: EQU 0x00000049 ; A variable's pointer for "FOR" loops
EORMSK: EQU 0x0000004A ; The mask for EORing in wait.
OPPTR: EQU 0x0000004B ; Pointer to current op's entry in "OPTAB".
OPMASK: EQU 0x0000004D ; Mask created by current operator.
TEMPF3: EQU 0x0000004E ; A third FAC temporary (4 bytes).
DSCPNT: EQU 0x00000050 ; Pointer to a string descriptor.
FOUR6: EQU 0x00000053 ; Variable constant used by garb collect.
JMPER: EQU 0x00000054
SIZE: EQU 0x00000055
OLDOV: EQU 0x00000056 ; The old overflow.
TEMPF1: EQU 0x00000057
HIGHDS: EQU 0x00000058 ; Destination of highest element in BLT.
HIGHTR: EQU 0x0000005A ; Source of highest element to move.
TEMPF2: EQU 0x0000005C
LOWDS: EQU 0x0000005D ; Location of last byte transferred into.
TENEXP: EQU 0x0000005E ; Has a DPT been input?
LOWTR: EQU 0x0000005F ; Last thing to move in BLT.
EXPSGN: EQU 0x00000060 ; Sign of base ten exponent.
FAC: EQU 0x00000061 ; The floating accumulator
FACHO: EQU 0x00000062 ; Most significant byte of mantissa.
FACMOH: EQU 0x00000063 ; One more.
FACMO: EQU 0x00000064 ; Middle order of mantissa.
FACLO: EQU 0x00000065 ; Least sig byte of mantissa.
FACSGN: EQU 0x00000066 ; Sign of FAC (0 or -1) when unpacked.
SGNFLG: EQU 0x00000067 ; Sign of FAC is preserved here by "FIN".
BITS: EQU 0x00000068 ; Something for "SHIFTR" to use.
ARGEXP: EQU 0x00000069
ARGHO: EQU 0x0000006A
ARGMOH: EQU 0x0000006B
ARGMO: EQU 0x0000006C
ARGLO: EQU 0x0000006D
ARGSGN: EQU 0x0000006E
ARISGN: EQU 0x0000006F ; A sign reflecting the result.
FACOV: EQU 0x00000070 ; Overflow byte of the FAC.
FBUFPT: EQU 0x00000071 ; Pointer into FBUFFR used by FOUT.
CHRGET: EQU 0x00000073 ; RAM code.
RNDX: EQU 0x0000008B
STATUS: EQU 0x00000090 ; I/O operation status byte
STKEY: EQU 0x00000091 ; STOP key flag
SVXT: EQU 0x00000092 ; Cassette: temp used to adjust software servo
VERCK: EQU 0x00000093 ; Cassette: verify or load flag (Z - loading)
C3P0: EQU 0x00000094 ; IEEE buffered char flag
BSOUR: EQU 0x00000095 ; Char buffer for IEEE
SYNO: EQU 0x00000096 ; Cassette: flags if we have block SYNC (16 zero dipoles)
XSAV: EQU 0x00000097 ; Temp for BASIN
LDTND: EQU 0x00000098 ; Index to logical file
DFLTN: EQU 0x00000099 ; Default input device #
DFLTO: EQU 0x0000009A ; Default output device #
PRTY: EQU 0x0000009B ; Cassette: holds current calculated parity bit
DPSW: EQU 0x0000009C ; Cassette: if NZ then expecting LL/L combination that ends a byte
MSGFLG: EQU 0x0000009D ; OS message flag
PTR1: EQU 0x0000009E ; Cassette: count of read locations in error (pointer into bad, max 61)
PTR2: EQU 0x0000009F ; Cassette: count of re-read locations (pointer into bad, during re-read)
TIME: EQU 0x000000A0 ; 24 hour clock in 1/60th seconds
R2D2: EQU 0x000000A3 ; Serial bus usage
BSOUR1: EQU 0x000000A4 ; Temp used by serial routine
COUNT: EQU 0x000000A5 ; Temp used by serial routine
BUFPT: EQU 0x000000A6 ; Cassette buffer pointer
INBIT: EQU 0x000000A7 ; RS-232 rcvr input bit storage
BITCI: EQU 0x000000A8 ; RS-232 rcvr bit count in
RINONE: EQU 0x000000A9 ; RS-232 rcvr flag for start bit check
RIDATA: EQU 0x000000AA ; RS-232 rcvr byte buffer
RIPRTY: EQU 0x000000AB ; RS-232 rcvr parity storage
SAL: EQU 0x000000AC ; Cassette: indirect to data storage area
SAH: EQU 0x000000AD
EAL: EQU 0x000000AE
EAH: EQU 0x000000AF
CMP0: EQU 0x000000B0 ; Cassette: software servo (+/- adjust to time calcs)
TEMP: EQU 0x000000B1 ; Cassette: used to hold dipole time during type calculations
TAPE1: EQU 0x000000B2 ; Address of tape buffer #1y.
BITTS: EQU 0x000000B4 ; RS-232 trns bit count
NXTBIT: EQU 0x000000B5 ; RS-232 trns next bit to be sent
RODATA: EQU 0x000000B6 ; RS-232 trns byte buffer
FNLEN: EQU 0x000000B7 ; Length current file n str
LA: EQU 0x000000B8 ; Current file logical addr
SA: EQU 0x000000B9 ; Current file 2nd addr
FA: EQU 0x000000BA ; Current file primary addr
FNADR: EQU 0x000000BB ; Addr current file name str
ROPRTY: EQU 0x000000BD ; RS-232 trns parity buffer
FSBLK: EQU 0x000000BE ; Cassette: indicate which block we're looking at (0 to exit)
MYCH: EQU 0x000000BF ; Cassette: holds input byte being built
CAS1: EQU 0x000000C0 ; Cassette manual/controlled switch
TMP0: EQU 0x000000C1
STAH: EQU 0x000000C2
MEMUSS: EQU 0x000000C3 ; Cassette load temps (2 bytes)
LSTX: EQU 0x000000C5 ; Key scan index
NDX: EQU 0x000000C6 ; Index to keyboard q
RVS: EQU 0x000000C7 ; RVS field on flag
INDX: EQU 0x000000C8
LSXP: EQU 0x000000C9 ; X pos at start
LSTP: EQU 0x000000CA
SFDX: EQU 0x000000CB ; SHIFT mode on print
BLNSW: EQU 0x000000CC ; Cursor blink enab
BLNCT: EQU 0x000000CD ; Count to toggle cur
GDBLN: EQU 0x000000CE ; Char before cursor
BLNON: EQU 0x000000CF ; On/off blink flag
CRSW: EQU 0x000000D0 ; INPUT vs GET flag
PNT: EQU 0x000000D1 ; Pointer to row
PNTR: EQU 0x000000D3 ; Pointer to column
QTSW: EQU 0x000000D4 ; Quote switch
LNMX: EQU 0x000000D5 ; 40/80 max position
TBLX: EQU 0x000000D6
DATA: EQU 0x000000D7 ; Cassette: holds most recent dipole bit value
INSRT: EQU 0x000000D8 ; Insert mode flag
LDTB1: EQU 0x000000D9 ; Line flags+endspace
USER: EQU 0x000000F3 ; Screen editor color IP
KEYTAB: EQU 0x000000F5 ; Keyscan table indirect
RIBUF: EQU 0x000000F7 ; RS-232 input buffer pointer
ROBUF: EQU 0x000000F9 ; RS-232 output buffer pointer
FREKZP: EQU 0x000000FB ; Free KERNAL zero page 9/24/80
BASZPT: EQU 0x000000FF ; Location ($00FF) used by BASIC
BAD: EQU 0x00000100 ; Cassette: storage space for bad read locations (bottom of stack)
BUF: EQU 0x00000200 ; BASIC/MONITOR buffer
LAT: EQU 0x00000259 ; Logical file numbers
FAT: EQU 0x00000263 ; Primary device numbers
SAT: EQU 0x0000026D ; Secondary addresses
KEYD: EQU 0x00000277 ; IRQ keyboard buffer
MEMSTR: EQU 0x00000281 ; Start of memory
MEMSIZ: EQU 0x00000283 ; Top of memory
TIMOUT: EQU 0x00000285 ; IEEE timeout flag
COLOR: EQU 0x00000286 ; Active color nybble
GDCOL: EQU 0x00000287 ; Original color before cursor
HIBASE: EQU 0x00000288 ; Base location of screen (top)
XMAX: EQU 0x00000289
RPTFLG: EQU 0x0000028A ; Key repeat flag
KOUNT: EQU 0x0000028B
DELAY: EQU 0x0000028C
SHFLAG: EQU 0x0000028D ; SHIFT flag byte
LSTSHF: EQU 0x0000028E ; Last SHIFT pattern
KEYLOG: EQU 0x0000028F ; Indirect for keyboard table setup
MODE: EQU 0x00000291 ; 0-PET mode, 1-cattacanna
AUTODN: EQU 0x00000292 ; Auto scroll down flag(=0 on,<>0 off)
M51CTR: EQU 0x00000293 ; 6551 control register
M51CDR: EQU 0x00000294 ; 6551 command register
M51AJB: EQU 0x00000295 ; Non standard (bittime/2-100)
RSSTAT: EQU 0x00000297 ; RS-232 status register
BITNUM: EQU 0x00000298 ; Number of bits to send (fast response)
BAUDOF: EQU 0x00000299 ; Baud rate full bit time (created by open)
RIDBE: EQU 0x0000029B ; Input buffer index to end
RIDBS: EQU 0x0000029C ; Input buffer pointer to start
RODBS: EQU 0x0000029D ; Output buffer index to start
RODBE: EQU 0x0000029E ; Output buffer index to end
IRQTMP: EQU 0x0000029F ; Holds irq during tape ops
ENABL: EQU 0x000002A1 ; RS-232 enables (replaces ier)
CASTON: EQU 0x000002A2 ; TOD sense during cassettes
KIKA26: EQU 0x000002A3 ; Cassette: holds old D1ICR after clear on read
STUPID: EQU 0x000002A4 ; Cassette: hold indicator (NZ - no T1IRQ yet) for T1IRQ
LINTMP: EQU 0x000002A5 ; Temporary for line index
PALNTS: EQU 0x000002A6 ; PAL vs NTSC flag 0=NTSC 1=PAL
IERROR: EQU 0x00000300 ; indirect ERROR (output error in .X)
IMAIN: EQU 0x00000302 ; indirect MAIN (system direct loop)
ICRNCH: EQU 0x00000304 ; indirect CRUNCH (tokenization routine)
IQPLOP: EQU 0x00000306 ; indirect LIST (char list)
IGONE: EQU 0x00000308 ; indirect GONE (char dispatch)
IEVAL: EQU 0x0000030A ; indirect EVAL (symbol evaluation)
SAREG: EQU 0x0000030C ; .A reg
SXREG: EQU 0x0000030D ; .X reg
SYREG: EQU 0x0000030E ; .Y reg
SPREG: EQU 0x0000030F ; .P reg
USRPOK: EQU 0x00000310 ; user function dispatch
CINV: EQU 0x00000314 ; IRQ RAM vector
CBINV: EQU 0x00000316 ; BRK instr RAM vector
NMINV: EQU 0x00000318 ; NMI RAM vector
IOPEN: EQU 0x0000031A
ICLOSE: EQU 0x0000031C
ICHKIN: EQU 0x0000031E
ICKOUT: EQU 0x00000320
ICLRCH: EQU 0x00000322
IBASIN: EQU 0x00000324
IBSOUT: EQU 0x00000326
ISTOP: EQU 0x00000328
IGETIN: EQU 0x0000032A
ICLALL: EQU 0x0000032C
USRCMD: EQU 0x0000032E
ILOAD: EQU 0x00000330
ISAVE: EQU 0x00000332 ; savesp
TBUFFR: EQU 0x0000033C ; cassette data b
BASIC_VECTORS: EQU 0x0000A000 ; start of the BASIC ROM
STMDSP: EQU 0x0000A00C ; action addresses for primary commands
FUNDSP: EQU 0x0000A052 ; action addresses for functions
USRLOC: EQU 0x0000A058
COSFIX: EQU 0x0000A066
SINFIX: EQU 0x0000A068
TANFIX: EQU 0x0000A06A
ATNFIX: EQU 0x0000A06C
OPTAB: EQU 0x0000A080 ; precedence byte and action addresses for operators
NEGTAB: EQU 0x0000A095
NOTTAB: EQU 0x0000A098
PTDORL: EQU 0x0000A09B
RESLST: EQU 0x0000A09E ; BASIC keywords
ERROR_MESSAGES: EQU 0x0000A19E ; BASIC error messages
ERRTAB: EQU 0x0000A1A0
ERROR_VECTORS: EQU 0x0000A328 ; error message pointer table
ERR: EQU 0x0000A364 ; BASIC messages
INTXT: EQU 0x0000A370
REDDY: EQU 0x0000A380
FNDFOR: EQU 0x0000A38A ; search the stack for FOR or GOSUB activity
FFLOOP: EQU 0x0000A38F
CMPFOR: EQU 0x0000A3A4
ADDFRS: EQU 0x0000A3B0
FFRTS: EQU 0x0000A3B7
BLTU: EQU 0x0000A3B8 ; open up a space in the memory, set the end of arrays
BLTUC: EQU 0x0000A3BF
BLT1: EQU 0x0000A3DC
BLTLP: EQU 0x0000A3E8
MOREN1: EQU 0x0000A3EC
DECBLT: EQU 0x0000A3F3
GETSTK: EQU 0x0000A3FB ; check room on stack for A bytes
REASON: EQU 0x0000A408 ; check available memory, do out of memory error if no room
TRYMOR: EQU 0x0000A412
REASAV: EQU 0x0000A416
REASTO: EQU 0x0000A421
REARTS: EQU 0x0000A434
OMERR: EQU 0x0000A435 ; do out of memory error then warm start
ERROR: EQU 0x0000A437
ERROR_WARM: EQU 0x0000A43A ; do error #X then warm start, the error message vector is initialised to point here
ERRCRD: EQU 0x0000A44E
GETERR: EQU 0x0000A456
TYPERR: EQU 0x0000A462
ERRFIN: EQU 0x0000A469 ; print string and do warm start, break entry
READY: EQU 0x0000A474 ; do warm start
MAIN: EQU 0x0000A483 ; BASIC warm start, the warm start vector is initialised to point here
MAIN1: EQU 0x0000A49C ; handle new BASIC line
QDECT1: EQU 0x0000A4D7
MLOOP: EQU 0x0000A4DF
NODEL: EQU 0x0000A4ED
NODELC: EQU 0x0000A508
STOLOP: EQU 0x0000A522
FINI: EQU 0x0000A52A
LNKPRG: EQU 0x0000A533 ; rebuild BASIC line chaining
CHEAD: EQU 0x0000A53C
CZLOOP: EQU 0x0000A544
LNKRTS: EQU 0x0000A55F
INLIN: EQU 0x0000A560
INLINC: EQU 0x0000A562
OUTBEL: EQU 0x0000A573
CRUNCH_VECTOR: EQU 0x0000A579 ; crunch BASIC tokens vector
CRUNCH: EQU 0x0000A57C ; crunch BASIC tokens, the crunch BASIC tokens vector is initialised to point here
KLOOP: EQU 0x0000A582
CMPSPC: EQU 0x0000A58E
KLOOP1: EQU 0x0000A5A4
MUSTCR: EQU 0x0000A5AC
RESER: EQU 0x0000A5B6
RESPUL: EQU 0x0000A5B7
RESCON: EQU 0x0000A5B8
GETBPT: EQU 0x0000A5C7
STUFFH: EQU 0x0000A5C9
COLIS: EQU 0x0000A5DC
NODATT: EQU 0x0000A5DE
STR1: EQU 0x0000A5E5
STRNG: EQU 0x0000A5EE
NTHIS: EQU 0x0000A5F5
NTHIS1: EQU 0x0000A5F9
CRDONE: EQU 0x0000A609
LISTRT: EQU 0x0000A612
FNDLIN: EQU 0x0000A613 ; search BASIC for temporary integer line number
FNDLNC: EQU 0x0000A617 ; search Basic for temp integer line number from AX
FNDLO1: EQU 0x0000A62E
AFFRTS: EQU 0x0000A637
FLINRT: EQU 0x0000A640
FLNRTS: EQU 0x0000A641
SCRATH: EQU 0x0000A642 ; perform NEW
SCRTCH: EQU 0x0000A644
RUNC: EQU 0x0000A659 ; reset execute pointer and do CLR
CLEAR: EQU 0x0000A65E ; perform CLR
CLEARC: EQU 0x0000A663
FLOAD: EQU 0x0000A677 ; do RESTORE and clear stack
STKINI: EQU 0x0000A67A ; flush BASIC stack and clear the continue pointer
STKRTS: EQU 0x0000A68D
STXTPT: EQU 0x0000A68E ; set BASIC execute pointer to start of memory - 1
LIST: EQU 0x0000A69C ; perform LIST
GOLST: EQU 0x0000A6A4
LSTEND: EQU 0x0000A6BB
LIST4: EQU 0x0000A6C9
TSTDUN: EQU 0x0000A6E6
TYPLIN: EQU 0x0000A6E8
PRIT4: EQU 0x0000A6EF
PLOOP: EQU 0x0000A6F3
PLOOP1: EQU 0x0000A700
GRODY: EQU 0x0000A714
QPLOP: EQU 0x0000A71A ; uncrunch BASIC tokens, the uncrunch BASIC tokens vector is initialised to point here
RESRCH: EQU 0x0000A72C
RESCR1: EQU 0x0000A72F
PRIT3: EQU 0x0000A737
FOR: EQU 0x0000A742 ; perform FOR
NOTOL: EQU 0x0000A753
LDFONE: EQU 0x0000A78B
ONEON: EQU 0x0000A79F
NXTCON: EQU 0x0000A7AB
NEWSTT_LOOP: EQU 0x0000A7AE ; interpreter inner loop
