GONE2: EQU 0x0000A7EF
GLET: EQU 0x0000A804
MORSTS: EQU 0x0000A807
SNERR1: EQU 0x0000A80B
SNERRX: EQU 0x0000A80E
RESTOR: EQU 0x0000A81D ; perform RESTORE
RESFIN: EQU 0x0000A827
ISCRTS: EQU 0x0000A82B
CHECK_STOP: EQU 0x0000A82C ; do CRTL-C check vector
STOP: EQU 0x0000A82F ; perform STOP
END: EQU 0x0000A831 ; perform END
STOPC: EQU 0x0000A832
STPEND: EQU 0x0000A841
DIRIS: EQU 0x0000A849
ENDCON: EQU 0x0000A84B
GORDY: EQU 0x0000A854
CONT: EQU 0x0000A857 ; perform CONT
CONTRT: EQU 0x0000A870
RUN: EQU 0x0000A878
GOSUB: EQU 0x0000A883 ; perform GOSUB
RUNC2: EQU 0x0000A897
GOTO: EQU 0x0000A8A0 ; perform GOTO
