; ***************************************************************************
; * NextZXOS API definitions                                                *
; ***************************************************************************


; ***************************************************************************
; * NextZXOS routine addresses                                              *
; ***************************************************************************

IDE_STREAM_OPEN         equ     $0056
IDE_STREAM_CLOSE        equ     $0059
IDE_STREAM_IN           equ     $005c
IDE_STREAM_OUT          equ     $005f
IDE_STREAM_PTR          equ     $0062

IDE_VERSION             equ     $00a0
IDE_INTERFACE           equ     $00a3
IDE_INIT                equ     $00a6
IDE_DRIVE               equ     $00a9
IDE_SECTOR_READ         equ     $00ac
IDE_SECTOR_WRITE        equ     $00af
IDE_FORMAT              equ     $00b2
IDE_PARTITION_FIND      equ     $00b5
IDE_PARTITION_NEW       equ     $00b8
IDE_PARTITION_INIT      equ     $00bb
IDE_PARTITION_ERASE     equ     $00be
IDE_PARTITION_RENAME    equ     $00c1
IDE_PARTITION_READ      equ     $00c4
IDE_PARTITION_WRITE     equ     $00c7
IDE_PARTITION_WINFO     equ     $00ca
IDE_PARTITION_OPEN      equ     $00cd
IDE_PARTITION_CLOSE     equ     $00d0
IDE_PARTITION_GETINFO   equ     $00d3
IDE_PARTITION_SETINFO   equ     $00d6
IDE_SWAP_OPEN           equ     $00d9
IDE_SWAP_CLOSE          equ     $00dc
IDE_SWAP_OUT            equ     $00df
IDE_SWAP_IN             equ     $00e2
IDE_SWAP_EX             equ     $00e5
IDE_SWAP_POS            equ     $00e8
IDE_SWAP_MOVE           equ     $00eb
IDE_SWAP_RESIZE         equ     $00ee
IDE_DOS_MAP             equ     $00f1
IDE_DOS_UNMAP           equ     $00f4
IDE_DOS_MAPPING         equ     $00f7
IDE_DOS_UNPERMANENT     equ     $00fa
IDE_SNAPLOAD            equ     $00fd

IDE_ACCESS_DATA         equ     $019f
IDE_IDENTIFY            equ     $01a2
IDE_PARTITIONS          equ     $01a5
IDE_FS_UNIT             equ     $01a8
IDE_FS_DRIVE            equ     $01ab
IDE_FS_FILE             equ     $01ae
IDE_PATH                equ     $01b1
IDE_CAPACITY            equ     $01b4
IDE_GET_LFN             equ     $01b7
IDE_BROWSER             equ     $01ba
IDE_BANK                equ     $01bd
IDE_BASIC               equ     $01c0
IDE_WINDOW_LINEIN       equ     $01c3
IDE_WINDOW_STRING       equ     $01c6
IDE_INTEGER_VAR         equ     $01c9
IDE_RTC                 equ     $01cc
IDE_DRIVER              equ     $01cf
IDE_MOUNT               equ     $01d2
IDE_MODE                equ     $01d5
IDE_TOKENISER           equ     $01d8


; ***************************************************************************
; * Reason codes for ide_fs_unit/drive/file                                 *
; ***************************************************************************

fs_request              equ     0
fs_release              equ     1
fs_gethead              equ     2
fs_puthead              equ     3


; ***************************************************************************
; * Reason codes for ide_path                                               *
; ***************************************************************************

rc_path_change          equ     0
rc_path_get             equ     1
rc_path_make            equ     2
rc_path_delete          equ     3


; ***************************************************************************
; * Reason codes for ide_bank                                               *
; ***************************************************************************

rc_bank_total           equ     0
rc_bank_alloc           equ     1
rc_bank_reserve         equ     2
rc_bank_free            equ     3


; ***************************************************************************
; * Bank types for ide_bank                                                 *
; ***************************************************************************

rc_banktype_zx          equ     0
rc_banktype_mmc         equ     1
rc_banktype_os          equ     $80     ; system use only


; ***************************************************************************
; * Browser capabilities mask                                               *
; ***************************************************************************

BROWSERCAPS_NONE        equ     $00     ; no capabilities
BROWSERCAPS_ALL         equ     $3f     ; all standard capabilities

BROWSERCAPS_COPY        equ     $01     ; files may be copied/moved
BROWSERCAPS_RENAME      equ     $02     ; files/directories may be renamed
BROWSERCAPS_MKDIR       equ     $04     ; directories may be created
BROWSERCAPS_ERASE       equ     $08     ; files/empty directories may be erased
BROWSERCAPS_REMOUNT     equ     $10     ; SD card may be remounted
BROWSERCAPS_UNMOUNT     equ     $20     ; drives may be unmounted
BROWSERCAPS_CAPS2       equ     $40     ; extended capabilities mask in B

BROWSERCAPS_SYSCFG      equ     $80     ; system use only - use browser.cfg


; ***************************************************************************
; * Browser extended capabilities mask                                      *
; ***************************************************************************

BROWSERCAPS2_RUNEXEC    equ     $01     ; .RUN directories may be executed
BROWSERCAPS2_GUIDE      equ     $02     ; guides may be shown (does not return)
BROWSERCAPS2_EXTEND     equ     $04     ; extended menu operations allowed
BROWSERCAPS2_SORT       equ     $08     ; directory sorting allowed (uses IDE_BANK)

BROWSERCAPS2_ALL        equ     $0f     ; all extended capabilities


; ***************************************************************************
; * Error codes                                                             *
; ***************************************************************************

rc_invpartition         equ     56
rc_partexist            equ     57
rc_notimp               equ     58
rc_partopen             equ     59
rc_nohandle             equ     60
rc_notswap              equ     61
rc_mapped               equ     62
rc_noxdpb               equ     63
rc_noswap               equ     64
rc_invdevice            equ     65
rc_8bitdata             equ     66
rc_cmdphase             equ     67
rc_dataphase            equ     68
rc_notdir               equ     69
rc_fragmented           equ     74      ; NOTE: NextBASIC uses errors 70..73
